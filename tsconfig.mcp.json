{
  // The MCP server is a plain node process, not part of the Next program: no DOM,
  // no JSX, and node's own types available. The root tsconfig is the opposite of
  // all three, which is why `mcp/` is excluded there and typechecked here instead.
  //
  // `nodenext` rather than `bundler`: this program is *emitted* (see
  // tsconfig.mcp.build.json) and run by node directly, so relative imports must
  // carry the `.js` extension node actually resolves. `bundler` would accept
  // extensionless imports here and produce output that fails at runtime.
  //
  // `lib/agentProtocol.ts` is pulled in explicitly — it is the one module shared
  // with the browser, and it compiles under both programs precisely because it
  // holds nothing but types and constants. If it ever stops compiling here, it has
  // grown an import it shouldn't have.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["mcp/**/*.ts", "lib/agentProtocol.ts"]
}
