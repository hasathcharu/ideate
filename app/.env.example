# ─── Auth.js (NextAuth v5) ───────────────────────────────────────────────
# Auth.js v5 auto-detects these variable names.

# A random secret used to encrypt the session JWT. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 33
AUTH_SECRET=

# GitHub App credentials (see README → "Register the GitHub App").
# These are the GitHub *App*'s "Client ID" and a generated client secret — NOT
# the App ID, and not an OAuth App's credentials. The variable names are kept as
# Auth.js expects them.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The GitHub App's URL slug — the <slug> in https://github.com/apps/<slug>.
# Used to build the "install / configure repository access" links. Public, not a
# secret; must be NEXT_PUBLIC_ because the repo picker renders those links.
NEXT_PUBLIC_GITHUB_APP_SLUG=

# Name of the app
NEXT_PUBLIC_APP_NAME=

# Cloudflare Analytics token
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Optional: set explicitly if the app is not served from http://localhost:3000
# in development, or behind a proxy in production.
# AUTH_URL=http://localhost:3000

# ─── Agent Link ──────────────────────────────────────────────────────────
# Origin of the Agent Link service (ideate-relay/) that browser tabs dial and that
# agents point their MCP client at. NEXT_PUBLIC_ because the browser is what
# opens the socket; not a secret, since the service issues nothing and pairing
# with it needs a code only the tab knows.
#
# Must be https, or http on localhost:7391 for a service you run yourself — the
# same rule the app enforces on the modal's Advanced options field and the
# service enforces on its own PUBLIC_URL. Defaults to the shared deployment when
# unset; a user can override it per browser from Advanced options.
NEXT_PUBLIC_RELAY_ORIGIN=
